# Copy to .env and fill in from: Supabase Dashboard → Project Settings → API

SUPABASE_URL=https://your-project-ref.supabase.co
# Backend: use the service_role key (keep secret, never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: set to false to skip auto-saving each detection to Supabase
SAVE_SCANS_TO_SUPABASE=true
